# 九章算子工作台 - 环境变量配置示例
# 复制此文件为 .env 并填入真实密钥

# ========================================
# AI 模型配置（OpenAI 兼容格式）
# ========================================

# API Key（必填，无 Key 时自动降级 Mock 模式）
JZO_AI_API_KEY=sk-your-api-key-here

# API Base URL（可选，默认使用 OpenAI 官方接口）
# 示例：https://api.openai.com/v1
# 示例：https://dashscope.aliyuncs.com/compatible-mode/v1
JZO_AI_BASE_URL=https://api.openai.com/v1

# 模型名称（可选，默认 gpt-3.5-turbo）
JZO_AI_MODEL=gpt-3.5-turbo

# ========================================
# 本地安全令牌
# ========================================

# 写操作令牌（用于 POST/PUT/DELETE 接口鉴权）
JZO_LOCAL_TOKEN=your-local-token-here

# ========================================
# 数据库配置
# ========================================

# SQLite 数据库路径（可选，默认 data/questions.db）
JZO_DATABASE_PATH=data/questions.db

# ========================================
# 其他配置
# ========================================

# 日志级别（可选，默认 INFO）
JZO_LOG_LEVEL=INFO

# 静态资源目录（可选，默认 static）
JZO_STATIC_DIR=static
