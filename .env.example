# 九章算子 - 环境变量配置示例
# 复制此文件为 .env 并填入真实密钥。.env 已被 .gitignore 拦住，密钥绝不进版本库。
# 装载器用 os.environ.setdefault，因此进程已有的同名环境变量优先于本文件。

# ========================================
# AI 模型配置（OpenAI 兼容，默认档）
# 三项都从环境变量读取，源码里没有默认模型名；缺 KEY 或 BASE_URL 即自动降级 Mock。
# ========================================

JZO_AI_API_KEY=sk-your-api-key-here
# 示例：https://api.openai.com/v1
# 示例：https://dashscope.aliyuncs.com/compatible-mode/v1
JZO_AI_BASE_URL=https://api.openai.com/v1
JZO_AI_MODEL=模型名

# ========================================
# 可选档（填了就出现在工作台 Provider 下拉里，不填则标「未配置」）
# ========================================

# JZO_BAILIAN_BASE_URL=
# JZO_BAILIAN_API_KEY=
# JZO_BAILIAN_MODEL=
# JZO_SILICONFLOW_BASE_URL=
# JZO_SILICONFLOW_API_KEY=
# JZO_SILICONFLOW_MODEL=

# 启动即选定的活跃档名称（openai-compatible | bailian | siliconflow）；
# 未填时按 环境变量 > 工作区 config.json > openai-compatible 兜底
# JZO_AI_PROVIDER=openai-compatible

# ========================================
# 本地安全令牌
# ========================================

# 写操作令牌（POST/PUT/DELETE 需带 X-JZO-Token）。
# 填了它 = 固定令牌，data/.local_token 的「用后即焚 + 轮换」整套机制不再生效，
# 只适合开发调试；日常使用请留空，让首启自动生成。
JZO_LOCAL_TOKEN=your-local-token-here

# ========================================
# 数据与监听
# ========================================

# 数据根目录（可选，默认仓库内 data/；测试与压测实例靠它换库）
JZO_DATA_DIR=data

# 监听地址与端口（可选，默认 127.0.0.1:8000，本底座只服务本机）
JZO_HOST=127.0.0.1
JZO_PORT=8000

# AI 请求超时秒数（可选，默认 30）
# JZO_AI_TIMEOUT_SECONDS=30
