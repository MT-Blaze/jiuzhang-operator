# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime data
.env
# data/ 是用户题库的物理载体，默认全部忽略；唯独 data/seed/ 是发版空库基线，
# 属于构建输入（0 题冻结库），必须随仓库走。
data/*
!data/seed/
data/backups/
static/uploads/
.system_generated/
*.log

# 首启静默安装的种子插件是运行时产物（源头在 examples/demo_plugin.zip）
plugins/org.jiuzhang.demo-bank/

# Build output
node_modules/
/dist/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# SQLite sidecars are runtime state, never package payload
*.db-shm
*.db-wal
*.db-journal

# 会话侦察与旧库只读快照，含第三方数据副本，永不入库
.scratch-recon-*/
.scratch-safe-*/

# ADR-003 纯净发版：内置真题库（456 题）只留本机开发，绝不进 git / 发行包。
# v063.db 是冻结的空基线（0 题，随包对外发布），不在剔除之列。
plugins/org.jiuzhang.bank-engine/bank/bank.db
plugins/org.jiuzhang.bank-engine/bank/v063_migrated.db
# 军令 #20 退役的旧插件目录：代码已删，本机还留着旧语料库与备份供回退，绝不入库。
plugins/org.jiuzhang.core-bank/bank/bank.db
plugins/org.jiuzhang.core-bank/bank/v063_migrated.db

# 结构升级备份（user_version 1→2 自动落盘）：只留本机回滚用，绝不进 git 与发行包。
*.pre-v082.bak

# 六工序流水线资产（.qoder/agents|rules|skills|records + skill-bank.json、scripts/check-*）随仓库走，必须入库。
# 只把本机生成的 RepoWiki 缓存挡在外面，wiki_plan.yaml 是配置、要留。
.qoder/repowiki/*
!.qoder/repowiki/wiki_plan.yaml
