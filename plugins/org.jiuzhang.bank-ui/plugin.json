{
  "schema_version": "1.0",
  "id": "org.jiuzhang.bank-ui",
  "name": "真题题库",
  "version": "0.1.0",
  "api_version": "1.0",
  "kind": "tool",
  "description": "题库视图插件（纯前端）：左侧大纲树、题目列表与详情、待审队列与查重双栏审查。题目数据一律经 Host API 向当前活跃题库引擎申请，插件不碰数据库。",
  "author": "九章算子",
  "license": "Apache-2.0",
  "min_host_version": "0.11.2",
  "entry": {
    "frontend": "dist/index.html"
  },
  "slots": ["question.card", "stage.center"],
  "capabilities": ["question.render", "bank.view"],
  "permissions": ["questions:read"],
  "ui": {
    "title": "真题题库筛选",
    "hint": "下拉选择会实时同步给题库画布（经事件总线），人类手改优先于 AI。",
    "controls": [
      {
        "type": "select",
        "key": "grade",
        "label": "年级",
        "options": [
          {"value": "全部", "label": "全部"},
          {"value": "高一", "label": "高一"},
          {"value": "高二", "label": "高二"},
          {"value": "高三", "label": "高三"}
        ],
        "default": "全部"
      },
      {
        "type": "select",
        "key": "difficulty",
        "label": "难度",
        "options": [
          {"value": "全部", "label": "全部"},
          {"value": "L1", "label": "L1 基础"},
          {"value": "L2", "label": "L2 中档"},
          {"value": "L3", "label": "L3 难"},
          {"value": "L4", "label": "L4 压轴"}
        ],
        "default": "全部"
      },
      {
        "type": "select",
        "key": "type",
        "label": "题型",
        "options": [
          {"value": "全部", "label": "全部"},
          {"value": "single_choice", "label": "单选"},
          {"value": "multiple_choice", "label": "多选"},
          {"value": "fill_blank", "label": "填空"},
          {"value": "solution", "label": "解答"}
        ],
        "default": "全部"
      }
    ]
  },
  "stage": {
    "region": "center",
    "mode": "takeover",
    "title": "真题题库",
    "priority": 80,
    "singleton": true
  },
  "bus": {
    "subscribe": ["ui.params.changed", "system.question_updated", "question.updated", "system.bank_query"],
    "publish": ["region.dock", "system.open_editor"]
  }
}
