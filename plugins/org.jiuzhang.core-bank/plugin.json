{
  "schema_version": "1.0",
  "id": "org.jiuzhang.core-bank",
  "name": "真题题库",
  "version": "0.4.0",
  "api_version": "1.0",
  "kind": "tool",
  "description": "456 道高中数学真题的本地 SQLite 题库：按年级、难度、题型与关键词筛选，支持预览与加入题篮。",
  "author": "九章算子",
  "license": "Apache-2.0",
  "entry": {
    "frontend": "dist/index.html"
  },
  "slots": ["question.card", "stage.center"],
  "capabilities": ["question.render"],
  "permissions": ["questions:read"],
  "ui": {
    "title": "真题题库筛选",
    "hint": "下拉选择会实时同步给题库画布（经事件总线），人类手改优先于 AI。",
    "controls": [
      {
        "type": "select",
        "key": "grade",
        "label": "年级",
        "options": [
          {"value": "全部", "label": "全部"},
          {"value": "高一", "label": "高一"},
          {"value": "高二", "label": "高二"},
          {"value": "高三", "label": "高三"}
        ],
        "default": "全部"
      },
      {
        "type": "select",
        "key": "difficulty",
        "label": "难度",
        "options": [
          {"value": "全部", "label": "全部"},
          {"value": "L1", "label": "L1 基础"},
          {"value": "L2", "label": "L2 中档"},
          {"value": "L3", "label": "L3 难"},
          {"value": "L4", "label": "L4 压轴"}
        ],
        "default": "全部"
      },
      {
        "type": "select",
        "key": "type",
        "label": "题型",
        "options": [
          {"value": "全部", "label": "全部"},
          {"value": "single_choice", "label": "单选"},
          {"value": "multiple_choice", "label": "多选"},
          {"value": "fill_blank", "label": "填空"},
          {"value": "solution", "label": "解答"}
        ],
        "default": "全部"
      }
    ]
  },
  "stage": {
    "region": "center",
    "mode": "takeover",
    "title": "真题题库",
    "priority": 80,
    "singleton": true
  },
  "bus": {
    "subscribe": ["ui.params.changed", "stage.tab.activated", "system.question_updated"],
    "publish": ["region.dock", "system.open_editor"]
  }
}
