{
  "schema_version": "1.0",
  "id": "org.jiuzhang.editor",
  "name": "录题工作台",
  "version": "0.2.1",
  "api_version": "1.0",
  "kind": "tool",
  "description": "中间表单、右侧 A4 预览：录题干与公式、动态增删选项、填答案与解析，一键清洗 LaTeX 后写入本地真题题库。",
  "author": "九章算子",
  "license": "Apache-2.0",
  "entry": {
    "frontend": "dist/index.html"
  },
  "slots": ["stage.center"],
  "capabilities": ["question.edit"],
  "permissions": ["questions:read", "questions:write"],
  "stage": {
    "region": "center",
    "mode": "takeover",
    "title": "录题工作台",
    "priority": 65,
    "singleton": true
  },
  "bus": {
    "subscribe": ["ui.params.changed", "system.open_editor"],
    "publish": ["region.dock", "stage.selection", "system.return_from_editor"]
  }
}
