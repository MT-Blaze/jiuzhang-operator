{
  "schema_version": "1.0",
  "id": "org.jiuzhang.editor",
  "name": "录题工作台",
  "version": "2.4.0",
  "api_version": "1.0",
  "kind": "tool",
  "description": "批次审核台：首屏左右 50/50，左栏历史批次，右栏圆角虚线收集筐——拖文件、点框、Ctrl+V 截图都落筐；筐内垂直单列（图标/文件名/红×）、独立滚动、底部固定【开始解析】才建批次。批次元数据接数据字典：11 场景、交叉标签按场景加权模糊匹配、新标签回车即记；学校只存 school_id、简称冲突硬拦截、AI 补全确认建档；标准名实时拼接、改元数据闪「已更新」、手改暂停。写库走宿主。",
  "author": "九章算子",
  "license": "Apache-2.0",
  "min_host_version": "1.0.0",
  "entry": {
    "frontend": "dist/index.html"
  },
  "slots": [
    "stage.center",
    "sidebar.right"
  ],
  "capabilities": [
    "question.edit"
  ],
  "permissions": [
    "assets:write",
    "assets:read",
    "questions:read",
    "questions:write",
    "ai:invoke"
  ],
  "ui": {
    "controls": [
      {
        "type": "select",
        "key": "format",
        "label": "源码格式",
        "default": "latex",
        "options": [
          { "value": "latex", "label": "格式一 · 标准 LaTeX" },
          { "value": "boxed", "label": "格式二 · 框框视图" }
        ]
      },
      {
        "type": "select",
        "key": "swap",
        "label": "中右栏互换",
        "default": "false",
        "options": [
          { "value": "false", "label": "源码在左" },
          { "value": "true", "label": "渲染在左" }
        ]
      }
    ]
  },
  "stage": {
    "region": "center",
    "mode": "takeover",
    "title": "录题工作台",
    "priority": 65,
    "singleton": true
  },
  "bus": {
    "subscribe": [
      "ui.params.changed",
      "system.open_editor",
      "editor.apply_patch",
      "stage.selection",
      "system.question_updated",
      "system.pending_updated",
      "editor.collect_files"
    ],
    "publish": [
      "region.dock",
      "stage.selection",
      "system.return_from_editor",
      "system.editor_close",
      "editor.collect_files"
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "org.jiuzhang.action.input.open_question",
        "title": "打开题目编辑",
        "description": "把题库里的一道题源码与元数据载入画布三栏；载入本身不写库，点保存才落库。",
        "params_schema": {
          "type": "object",
          "properties": {
            "question_id": {
              "type": "string",
              "description": "题目 id（q_ 开头）",
              "maxLength": 80
            }
          },
          "required": [
            "question_id"
          ],
          "additionalProperties": false
        },
        "returns": "{question_id, editing}"
      },
      {
        "id": "org.jiuzhang.action.process.clean_latex",
        "title": "清洗当前表单",
        "description": "对画布中栏的 exam-zh 源码做定界符规范化（\\( \\)、\\[ \\] 归一为 $ 与 $$）；会改写未保存内容，必须在执行前确认。",
        "requires_user": true,
        "params_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "returns": "{touched}"
      },
      {
        "id": "org.jiuzhang.action.input.save_question",
        "title": "保存当前题目",
        "description": "把当前题的源码与辅助栏元数据组装成 2.0 结构写入题库（新题走 bank.create，编辑态走 bank.update 且保住既有多来源）；写库且会回流刷新各端，必须在执行前确认。",
        "requires_user": true,
        "params_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "returns": "{question_id, created}"
      },
      {
        "id": "org.jiuzhang.action.process.create_variant",
        "title": "派生变式题",
        "description": "用当前表单另存一道新题（底座重新签发 id），绝不覆盖原题；写库，必须在执行前确认。",
        "requires_user": true,
        "params_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "returns": "{question_id, parent_id}"
      }
    ]
  }
}
