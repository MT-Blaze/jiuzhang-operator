{
  "schema_version": "1.0",
  "id": "org.jiuzhang.editor",
  "name": "录题工作台",
  "version": "1.5.0",
  "api_version": "1.0",
  "kind": "tool",
  "description": "画布三栏：左原图 | 中 exam-zh 源码（格式一整段编辑 / 格式二拆框后自动重组） | 右按内容实际高度渲染；单题与批量同一界面，滚动跟题、左栏逐题跳转，底部【保存全部】只提交脏题；右栏辅助面板放题型、难度、来源、考向、标签、AI 帮改（只改题干段与解析段，点采用才回填画布）与审核动作；写库一律经宿主（新建 bank.create、编辑 bank.update），插件不碰令牌。",
  "author": "九章算子",
  "license": "Apache-2.0",
  "min_host_version": "1.0.0",
  "entry": {
    "frontend": "dist/index.html"
  },
  "slots": [
    "stage.center",
    "sidebar.right"
  ],
  "capabilities": [
    "question.edit"
  ],
  "permissions": [
    "assets:write",
    "questions:read",
    "questions:write",
    "ai:invoke"
  ],
  "ui": {
    "title": "录题面板",
    "hint": "源码格式切换只改画布中栏的编辑视图，题目内容不动。",
    "controls": [
      {
        "type": "select",
        "id": "format",
        "label": "源码格式",
        "default": "latex",
        "options": [
          { "value": "latex", "label": "格式一 · 标准 LaTeX" },
          { "value": "boxed", "label": "格式二 · 框框视图" }
        ]
      }
    ]
  },
  "stage": {
    "region": "center",
    "mode": "takeover",
    "title": "录题工作台",
    "priority": 65,
    "singleton": true
  },
  "bus": {
    "subscribe": [
      "ui.params.changed",
      "system.open_editor",
      "editor.apply_patch",
      "stage.selection",
      "system.question_updated"
    ],
    "publish": [
      "region.dock",
      "stage.selection",
      "system.return_from_editor",
      "system.editor_close"
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "org.jiuzhang.action.input.open_question",
        "title": "打开题目编辑",
        "description": "把题库里的一道题源码与元数据载入画布三栏；载入本身不写库，点保存才落库。",
        "params_schema": {
          "type": "object",
          "properties": {
            "question_id": {
              "type": "string",
              "description": "题目 id（q_ 开头）",
              "maxLength": 80
            }
          },
          "required": [
            "question_id"
          ],
          "additionalProperties": false
        },
        "returns": "{question_id, editing}"
      },
      {
        "id": "org.jiuzhang.action.process.clean_latex",
        "title": "清洗当前表单",
        "description": "对画布中栏的 exam-zh 源码做定界符规范化（\\( \\)、\\[ \\] 归一为 $ 与 $$）；会改写未保存内容，必须在执行前确认。",
        "requires_user": true,
        "params_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "returns": "{touched}"
      },
      {
        "id": "org.jiuzhang.action.input.save_question",
        "title": "保存当前题目",
        "description": "把当前题的源码与辅助栏元数据组装成 2.0 结构写入题库（新题走 bank.create，编辑态走 bank.update 且保住既有多来源）；写库且会回流刷新各端，必须在执行前确认。",
        "requires_user": true,
        "params_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "returns": "{question_id, created}"
      },
      {
        "id": "org.jiuzhang.action.process.create_variant",
        "title": "派生变式题",
        "description": "用当前表单另存一道新题（底座重新签发 id），绝不覆盖原题；写库，必须在执行前确认。",
        "requires_user": true,
        "params_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "returns": "{question_id, parent_id}"
      }
    ]
  }
}
