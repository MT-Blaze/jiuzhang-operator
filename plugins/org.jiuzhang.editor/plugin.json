{
  "schema_version": "1.0",
  "id": "org.jiuzhang.editor",
  "name": "录题工作台",
  "version": "1.0.0",
  "api_version": "1.0",
  "kind": "tool",
  "description": "左表单、中栏源码对照 A4 实时渲染、右栏原图框选切图；录题干公式、动态选项（含选项配图）、答案解析，支持一题挂多张来源卷（各记原卷题号）、教材/章/节、本地图片上传并关联 images 与选项 image_ids；草稿托管、派生变式、删题二次确认，保存经宿主写库。本地一键清洗 + 底座统一 AI 清洗公式。",
  "author": "九章算子",
  "license": "Apache-2.0",
  "min_host_version": "1.0.0",
  "entry": {
    "frontend": "dist/index.html"
  },
  "slots": [
    "stage.center"
  ],
  "capabilities": [
    "question.edit"
  ],
  "permissions": [
    "assets:write",
    "questions:read",
    "questions:write"
  ],
  "stage": {
    "region": "center",
    "mode": "takeover",
    "title": "录题工作台",
    "priority": 65,
    "singleton": true
  },
  "bus": {
    "subscribe": [
      "ui.params.changed",
      "system.open_editor",
      "editor.apply_patch"
    ],
    "publish": [
      "region.dock",
      "stage.selection",
      "system.return_from_editor",
      "system.editor_close"
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "org.jiuzhang.action.input.open_question",
        "title": "打开题目编辑",
        "description": "把题库里的一道题载入录题工作台；只读载入，未保存前不改动原题。",
        "params_schema": {
          "type": "object",
          "properties": {
            "question_id": {
              "type": "string",
              "description": "题目 id（q_ 开头）",
              "maxLength": 80
            }
          },
          "required": [
            "question_id"
          ],
          "additionalProperties": false
        },
        "returns": "{question_id, editing}"
      },
      {
        "id": "org.jiuzhang.action.process.clean_latex",
        "title": "清洗当前表单",
        "description": "对当前表单的题干、选项、答案与解析做 LaTeX 规范化；会改写未保存内容，必须在执行前确认。",
        "requires_user": true,
        "params_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "returns": "{touched}"
      },
      {
        "id": "org.jiuzhang.action.input.save_question",
        "title": "保存当前题目",
        "description": "把当前表单写入题库（新题新建，编辑态则更新原题）；写库且会回流刷新各端，必须在执行前确认。",
        "requires_user": true,
        "params_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "returns": "{question_id, created}"
      },
      {
        "id": "org.jiuzhang.action.process.create_variant",
        "title": "派生变式题",
        "description": "用当前表单另存一道新题（底座重新签发 id），绝不覆盖原题；写库，必须在执行前确认。",
        "requires_user": true,
        "params_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "returns": "{question_id, parent_id}"
      }
    ]
  }
}
